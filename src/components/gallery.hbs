<section class="gallery">
  <div class="container">
    <div class="gallery__contant">
      <div class="swiper-container">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
              <picture class="gallery__img">
                  <img src="./images/gallery1.png" alt="Изображение 1">
              </picture>
          </div>
          <div class="swiper-slide">
              <picture class="gallery__img">
                  <img src="./images/gallery2.png" alt="Изображение 2">
              </picture>
          </div>
          <div class="swiper-slide">
              <picture class="gallery__img">
                  <img src="./images/gallery3.png" alt="Изображение 3">
              </picture>
          </div>
        </div>
      </div>

      <div class="gallery__block">
        <h2 class="gallery__title title">Галерея</h2>
        <ul class="gallery__arrow arrows list">
          <li class="arrow__left arrow left">
            <img class="left__img" src="./images/left.svg" alt="Назад">
          </li>
          <li class="arrow__right arrow">
            <img class="right__img" src="./images/right.svg" alt="Вперед">
          </li>
        </ul>
      </div>
    </div>
